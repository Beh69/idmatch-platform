{
  "name": "idmatch-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Interior-design matching platform implementing user stories ID01-ID08 (BCE architecture, Singapore context)",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "seed": "tsx src/server/seed.ts",
    "generate": "tsx src/server/generateData.ts",
    "stress": "node stress/stress.mjs",
    "dev:client": "vite",
    "build:client": "vite build",
    "build": "npm run build:client && npm run build:server",
    "test": "tsx tests/run.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
